# Temp
*.tmp
*.bak
implementation_plan.md

# ── Generated artifacts: do NOT commit ────────────────────────────────────
# Models, reports, and data are regenerated by the pipeline.
# Committing them causes "stale artifact" confusion (git shows dirty state
# even when only code changed). Re-run the pipeline to regenerate locally.
reports/
models/
data/processed/

# Allow raw data manifests (small, reproducibility-critical)
!data/raw/.gitkeep

# PyTorch Lightning run logs (new version dir created on every run)
lightning_logs/
