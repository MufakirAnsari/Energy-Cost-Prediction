# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/

# Virtual environment (too large ~1GB)
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# Logs
logs/
